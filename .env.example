# --- Mode -------------------------------------------------------------------
# demo  : no keys needed; synthetic blockchain data + simulated TinyFish replies
# live  : real Etherscan / TronGrid data and real TinyFish calls
# auto  : live where a key exists, demo otherwise (default)
CHAINSIGHT_MODE=auto

# --- TinyFish (https://agent.tinyfish.ai/api-keys) ----------------------------
TINYFISH_API_KEY=

# --- Blockchain data ------------------------------------------------------------
# Etherscan V2 multichain key (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=
# TronGrid key is optional (works without, but rate limited) (https://www.trongrid.io)
TRONGRID_API_KEY=

# --- Tracing limits ---------------------------------------------------------------
TRACE_MAX_HOPS=8
TRACE_MAX_BRANCH=4
TRACE_MAX_NODES=80

# --- Optional: protect the REST API with a key (header X-API-Key) -----------------
CHAINSIGHT_API_KEY=
